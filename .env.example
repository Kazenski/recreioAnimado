# ============================================================================
# Configuração do Firebase (valores PÚBLICOS — os mesmos do console do projeto)
# NÃO coloque aqui chaves secretas. Estes valores vão para o navegador.
# No GitHub, são injetados pelo workflow a partir dos Secrets do repositório.
# ============================================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ============================================================================
# Segredos do servidor (Cloud Functions) — NÃO vão para o navegador.
# Configure com:
#   firebase functions:secrets:set YOUTUBE_API_KEY
#   firebase functions:secrets:set PROF_SENHA
# ============================================================================
YOUTUBE_API_KEY=
PROF_SENHA=
