rules_version = '2';

// ============================================================================
// ATENÇÃO — leia antes de fazer deploy das regras:
//
// Este arquivo nega TODO acesso direto do cliente ao Firestore. O site do
// Recreio Animado NÃO usa o SDK do Firestore no navegador: todas as leituras e
// gravações passam pelas Cloud Functions (que usam o Admin SDK e ignoram estas
// regras). Isso mantém a senha do professor e o ranking protegidos.
//
// Faça o deploy destas regras SOMENTE no projeto Firebase DEDICADO deste app
// (o padrão em .firebaserc: "recreio-animado"). NÃO faça deploy das regras
// neste arquivo no projeto do site principal (kazenski-a1bb2), ou o site
// principal perderá o acesso dele ao banco.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
